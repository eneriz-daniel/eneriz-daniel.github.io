---
import Base from '../layouts/Base.astro';
import PubItem from './PubItem.astro';
import { t, paths, type Lang } from '../i18n/content';
import { publications, theses, type PubKind } from '../data/publications';
import { hl } from '../i18n/util';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const r = s.researchPage;
const groups: { kind: PubKind; label: string }[] = [
  { kind: 'journal', label: r.journal },
  { kind: 'conference', label: r.conference },
  { kind: 'local', label: r.local },
];
---
<Base lang={lang} page="research" title={r.title}>
  <header class="head">
    <p class="mono"><a href={paths[lang].home}>{r.back}</a></p>
    <h1>{r.title}</h1>
    <p class="muted">{r.intro}</p>
  </header>

  {groups.map((g) => (
    <section class="section">
      <h2 class="label">{g.label}</h2>
      <ul class="body list">
        {publications.filter((p) => p.kind === g.kind).map((pub) => (
          <PubItem pub={pub} lang={lang} showAuthors codeLabel={r.code} />
        ))}
      </ul>
    </section>
  ))}

  <section class="section">
    <h2 class="label">{r.theses}</h2>
    <ul class="body list">
      {theses.map((th) => (
        <li class="thesis">
          <span class="mono muted" set:html={hl(th.year)} />
          <div>
            <div set:html={hl(th.title)} />
            <div class="mono meta"><span class="tag">{th.degree[lang]}</span>{th.note && <span>★ {th.note[lang]}</span>}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .head { padding: 2.5rem 0 2rem; }
  .head a { color: var(--muted); text-decoration: none; }
  .head a:hover { color: var(--accent); }
  h1 { font-size: 2rem; margin: 0.75rem 0 0.5rem; }
  .list { list-style: none; padding: 0; margin: 0; }
  .thesis {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px dashed var(--line);
    line-height: 1.4;
  }
  .thesis:last-child { border-bottom: 0; }
  .meta { display: flex; gap: 0.9rem; margin-top: 0.35rem; font-size: 0.74rem; color: var(--muted); }
  .tag { color: var(--accent); }
</style>
